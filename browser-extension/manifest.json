{
  "manifest_version": 3,
  "name": "Streamers Center Slot Capture",
  "description": "Detects slot games, lets the streamer select capture regions and connects them to the local StreamersCenter capture agent.",
  "version": "0.2.0",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": [
    "https://*.streamerscenter.com/*",
    "https://streamerscenter.com/*",
    "https://*.stake.com/*",
    "https://*.stake.us/*",
    "https://*.gamdom.com/*",
    "https://*.roobet.com/*",
    "https://*.shuffle.com/*",
    "https://*.rollbit.com/*",
    "https://*.pragmaticplay.net/*",
    "https://*.pragmaticplaylive.net/*",
    "https://*.hacksawgaming.com/*",
    "https://*.nolimitcity.com/*",
    "https://*.relax-gaming.com/*",
    "https://*.playngo.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.stake.com/*",
        "https://*.stake.us/*",
        "https://*.gamdom.com/*",
        "https://*.roobet.com/*",
        "https://*.shuffle.com/*",
        "https://*.rollbit.com/*",
        "https://*.pragmaticplay.net/*",
        "https://*.pragmaticplaylive.net/*",
        "https://*.hacksawgaming.com/*",
        "https://*.nolimitcity.com/*",
        "https://*.relax-gaming.com/*",
        "https://*.playngo.com/*",
        "https://streamerscenter.com/*",
        "https://*.streamerscenter.com/*",
        "http://localhost:*/*"
      ],
      "js": ["src/captureCandidates.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Streamers Center Slot Capture",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "116"
}
